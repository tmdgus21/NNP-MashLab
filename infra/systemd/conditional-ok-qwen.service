[Unit]
Description=Conditional OK Qwen3 1.7B Q8_0 (llama.cpp, loopback only)
After=network.target

[Service]
Type=simple
User=linuxuser
WorkingDirectory=/home/linuxuser
Environment=HOME=/home/linuxuser
ExecStart=/home/linuxuser/.local/bin/llama serve -m /home/linuxuser/models/Qwen3-1.7B-Q8_0.gguf --alias Qwen3-1.7B-Q8_0 --host 127.0.0.1 --port 8080 --ctx-size 8192 --parallel 1 --threads 4 --reasoning off --no-webui
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
