# 1. 백엔드 API 서버 라우팅
api.본인도메인.com {
    # 외부 요청을 내부 Docker 네트워크의 'server-api' 컨테이너(80번 포트)로 전달
    reverse_proxy server-api:80
}

# 2. 유지보수 대시보드 라우팅
monitor.본인도메인.com {
    # 외부 요청을 내부 Docker 네트워크의 'ops-dashboard' 컨테이너(80번 포트)로 전달
    reverse_proxy ops-dashboard:80
}

# 로컬 테스트용 Caddyfile 임시 코드
http://localhost:8080 {
    reverse_proxy server-api:80
}

http://localhost:8081 {
    reverse_proxy ops-dashboard:80
}