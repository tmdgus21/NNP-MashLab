# External PostgreSQL (host-installed PG 18)
# v2.1 production target. Never set DB_NAME to the legacy ok_* database
# (mashpotato-server-db). deploy.sh refuses that mix.
DB_USER=mashlab
DB_PASSWORD=change-me
DB_NAME=potato_server_v2
DB_HOST=172.19.0.1
DB_PORT=5432

# Grafana
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
GRAFANA_DATA_PATH=/var/lib/grafana
GRAFANA_CONFIG_PATH=/etc/grafana/grafana.ini

# Application — leave empty to use DB_* parts inside the container, or set to potato_server_v2
DATABASE_URL=
