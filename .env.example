# PostgreSQL
POSTGRES_USER=mashlab
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mashlab
POSTGRES_PORT=5432

# Grafana
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
